---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<div class="instructor-footer-block">
	<div class="instructor-footer-inner">
		<div class="instructor-identity">
			<div class="instructor-avatar-frame">
				<span class="instructor-avatar-initials">MH</span>
			</div>
			<div class="instructor-text">
				<div class="instructor-label">COURSE ARCHITECT & INSTRUCTOR</div>
				<div class="instructor-name">Mohamed Helmy</div>
			</div>
		</div>
		<div class="instructor-meta">
			<span class="instructor-discipline">Clean Architecture · GoF Patterns · Java & Kotlin</span>
			<div class="instructor-links">
				<a href="https://helmy.is-a.dev" target="_blank" rel="noopener noreferrer" class="footer-link" title="Instructor Website">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
					<span>helmy.is-a.dev</span>
				</a>
				<span class="footer-sep">/</span>
				<a href="https://github.com/Helmy2" target="_blank" rel="noopener noreferrer" class="footer-link" title="GitHub Profile">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
					<span>@Helmy2</span>
				</a>
				<span class="footer-sep">/</span>
				<a href="https://github.com/Helmy2/design-pattern-course" target="_blank" rel="noopener noreferrer" class="footer-link" title="Course GitHub Repository">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
					<span>Source Repo</span>
				</a>
			</div>
		</div>
	</div>
</div>

<style>
	.instructor-footer-block {
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--arch-border, #1f2a3f);
		font-family: var(--sl-font-system-sans);
	}

	.instructor-footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding: 1.25rem 1.5rem;
		background: var(--arch-surface, #111726);
		border: 1px solid var(--arch-border, #1f2a3f);
		border-left: 3px solid var(--arch-cyan, #38bdf8);
		border-radius: 6px;
	}

	.instructor-identity {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.instructor-avatar-frame {
		width: 38px;
		height: 38px;
		border-radius: 4px;
		background: var(--arch-surface-raised, #182032);
		border: 1px solid var(--arch-border, #1f2a3f);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--arch-cyan, #38bdf8);
		font-family: var(--sl-font-system-mono, monospace);
		font-weight: 700;
		font-size: 0.85rem;
		letter-spacing: 0.05em;
	}

	.instructor-label {
		font-family: var(--sl-font-system-mono, monospace);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--arch-cyan, #38bdf8);
	}

	.instructor-name {
		font-size: 1rem;
		font-weight: 700;
		color: var(--arch-ink-primary, #f1f5f9);
	}

	.instructor-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.4rem;
	}

	.instructor-discipline {
		font-size: 0.82rem;
		color: var(--arch-ink-muted, #64748b);
		font-family: var(--sl-font-system-mono, monospace);
	}

	.instructor-links {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--sl-font-system-mono, monospace);
		font-size: 0.78rem;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--arch-ink-secondary, #94a3b8);
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.footer-link:hover {
		color: var(--arch-cyan, #38bdf8);
		text-decoration: underline;
	}

	.footer-sep {
		color: var(--arch-border, #1f2a3f);
	}

	@media (max-width: 768px) {
		.instructor-footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
		.instructor-meta {
			align-items: flex-start;
		}
	}
</style>
