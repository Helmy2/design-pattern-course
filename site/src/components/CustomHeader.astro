---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
---

<script is:inline>
	// Run early before paint to prevent layout shifts (FOUC)
	(function() {
		try {
			const focus = localStorage.getItem('dp_focus_mode') === 'true';
			const hideLeft = localStorage.getItem('dp_sidebar_closed') === 'true';
			const hideRight = localStorage.getItem('dp_toc_closed') === 'true';
			const html = document.documentElement;

			if (focus) {
				html.setAttribute('data-focus-mode', 'true');
				html.setAttribute('data-sidebar-hidden', 'true');
				html.setAttribute('data-toc-hidden', 'true');
			} else {
				if (hideLeft) html.setAttribute('data-sidebar-hidden', 'true');
				if (hideRight) html.setAttribute('data-toc-hidden', 'true');
			}
		} catch (e) {}
	})();
</script>

<div class="header-inner">
	<div class="left-section">
		<SiteTitle />

		<!-- Panel Controls Group -->
		<div class="panel-toggles" role="toolbar" aria-label="Layout controls">
			<!-- Toggle Left Sidebar -->
			<button 
				id="btn-toggle-sidebar" 
				class="panel-control-btn" 
				type="button" 
				title="Toggle Left Sidebar (Ctrl+B)" 
				aria-label="Toggle navigation sidebar"
			>
				<svg class="panel-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
					<line x1="9" y1="3" x2="9" y2="21" class="panel-sidebar-line" />
				</svg>
				<span class="btn-text">Sidebar</span>
			</button>

			<!-- Toggle Focus Mode (Both panels closed, max width) -->
			<button 
				id="btn-toggle-focus" 
				class="panel-control-btn focus-mode-btn" 
				type="button" 
				title="Toggle Focus Mode (Alt+Z / Esc)" 
				aria-label="Toggle focus mode"
			>
				<svg class="panel-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
				</svg>
				<span class="btn-text" id="focus-btn-label">Focus</span>
			</button>

			<!-- Toggle Right Outline/TOC -->
			<button 
				id="btn-toggle-toc" 
				class="panel-control-btn" 
				type="button" 
				title="Toggle Outline / TOC" 
				aria-label="Toggle table of contents"
			>
				<svg class="panel-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
					<line x1="15" y1="3" x2="15" y2="21" class="panel-sidebar-line" />
				</svg>
				<span class="btn-text">Outline</span>
			</button>
		</div>
	</div>

	<div class="center-section">
		<Search />
	</div>

	<div class="right-section">
		<a 
			href="https://github.com/Helmy2/design-pattern-course" 
			target="_blank" 
			rel="noopener noreferrer" 
			class="repo-link"
			title="GitHub: design-pattern-course"
		>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
				<path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
			</svg>
		</a>
		<ThemeSelect />
	</div>
</div>


<style>
	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: 100%;
		height: 100%;
	}

	.left-section {
		display: flex;
		align-items: center;
		gap: 1.25rem;
		min-width: 0;
	}

	/* Layout controls toolbar */
	.panel-toggles {
		display: inline-flex;
		align-items: center;
		background: var(--arch-surface, #111726);
		border: 1px solid var(--arch-border, #1f2a3f);
		border-radius: 6px;
		padding: 2px;
		gap: 2px;
	}

	.panel-control-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.38rem;
		padding: 0.32rem 0.65rem;
		background: transparent;
		border: 1px solid transparent;
		border-radius: 4px;
		color: var(--arch-ink-secondary, #94a3b8);
		font-family: var(--sl-font-system-mono, monospace);
		font-size: 0.76rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.15s ease;
		white-space: nowrap;
		line-height: 1;
	}

	.panel-control-btn:hover {
		color: var(--arch-ink-primary, #f1f5f9);
		background: var(--arch-surface-raised, #182032);
		border-color: var(--arch-border, #1f2a3f);
	}

	/* Panel closed/collapsed indicator */
	.panel-control-btn.is-collapsed {
		color: var(--arch-cyan, #38bdf8);
		background: rgba(56, 189, 248, 0.08);
		border-color: rgba(56, 189, 248, 0.25);
	}

	/* Focus mode button styling */
	.focus-mode-btn {
		font-weight: 600;
	}

	.focus-mode-btn.is-active {
		color: #ffffff;
		background: #0284c7;
		border-color: #38bdf8;
		box-shadow: 0 0 10px rgba(56, 189, 248, 0.35);
	}

	.center-section {
		flex: 1;
		max-width: 480px;
	}

	.right-section {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.repo-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 34px;
		height: 34px;
		border-radius: 6px;
		color: var(--arch-ink-secondary, #94a3b8);
		background: transparent;
		border: 1px solid transparent;
		transition: all 0.15s ease;
	}

	.repo-link:hover {
		color: var(--arch-cyan, #38bdf8);
		background: var(--arch-surface-raised, #182032);
		border-color: var(--arch-border, #1f2a3f);
	}


	/* Responsive layout rules */
	@media (max-width: 768px) {
		.btn-text {
			display: none;
		}
		.panel-control-btn {
			padding: 0.35rem;
		}
		.center-section {
			max-width: none;
		}
	}

	@media (max-width: 580px) {
		.panel-toggles {
			display: none;
		}
	}
</style>

<script is:inline>
	function setupPanelControls() {
		const html = document.documentElement;
		const btnSidebar = document.getElementById('btn-toggle-sidebar');
		const btnFocus = document.getElementById('btn-toggle-focus');
		const btnToc = document.getElementById('btn-toggle-toc');
		const focusLabel = document.getElementById('focus-btn-label');

		function isSidebarClosed() {
			return html.getAttribute('data-sidebar-hidden') === 'true';
		}
		function isTocClosed() {
			return html.getAttribute('data-toc-hidden') === 'true';
		}
		function isFocusActive() {
			return html.getAttribute('data-focus-mode') === 'true';
		}

		function syncUI() {
			const closedSidebar = isSidebarClosed();
			const closedToc = isTocClosed();
			const focus = isFocusActive();

			if (btnSidebar) {
				btnSidebar.classList.toggle('is-collapsed', closedSidebar || focus);
				btnSidebar.setAttribute('aria-pressed', (closedSidebar || focus) ? 'true' : 'false');
				btnSidebar.title = (closedSidebar || focus) ? 'Open Left Sidebar (Ctrl+B)' : 'Close Left Sidebar (Ctrl+B)';
			}

			if (btnToc) {
				btnToc.classList.toggle('is-collapsed', closedToc || focus);
				btnToc.setAttribute('aria-pressed', (closedToc || focus) ? 'true' : 'false');
				btnToc.title = (closedToc || focus) ? 'Open Outline / TOC' : 'Close Outline / TOC';
			}

			if (btnFocus) {
				btnFocus.classList.toggle('is-active', focus);
				btnFocus.setAttribute('aria-pressed', focus ? 'true' : 'false');
				btnFocus.title = focus ? 'Exit Focus Mode (Alt+Z / Esc)' : 'Enter Focus Mode (Alt+Z)';
				if (focusLabel) {
					focusLabel.textContent = focus ? 'Exit Focus' : 'Focus';
				}
			}
		}

		function toggleSidebar() {
			if (isFocusActive()) {
				// If in focus mode, exit focus mode and open sidebar
				html.removeAttribute('data-focus-mode');
				html.removeAttribute('data-sidebar-hidden');
				localStorage.setItem('dp_focus_mode', 'false');
				localStorage.setItem('dp_sidebar_closed', 'false');
			} else {
				const next = !isSidebarClosed();
				if (next) html.setAttribute('data-sidebar-hidden', 'true');
				else html.removeAttribute('data-sidebar-hidden');
				localStorage.setItem('dp_sidebar_closed', next ? 'true' : 'false');
			}
			syncUI();
		}

		function toggleToc() {
			if (isFocusActive()) {
				html.removeAttribute('data-focus-mode');
				html.removeAttribute('data-toc-hidden');
				localStorage.setItem('dp_focus_mode', 'false');
				localStorage.setItem('dp_toc_closed', 'false');
			} else {
				const next = !isTocClosed();
				if (next) html.setAttribute('data-toc-hidden', 'true');
				else html.removeAttribute('data-toc-hidden');
				localStorage.setItem('dp_toc_closed', next ? 'true' : 'false');
			}
			syncUI();
		}

		function toggleFocus() {
			const nextFocus = !isFocusActive();
			if (nextFocus) {
				html.setAttribute('data-focus-mode', 'true');
				html.setAttribute('data-sidebar-hidden', 'true');
				html.setAttribute('data-toc-hidden', 'true');
				localStorage.setItem('dp_focus_mode', 'true');
			} else {
				html.removeAttribute('data-focus-mode');
				html.removeAttribute('data-sidebar-hidden');
				html.removeAttribute('data-toc-hidden');
				localStorage.setItem('dp_focus_mode', 'false');
				localStorage.setItem('dp_sidebar_closed', 'false');
				localStorage.setItem('dp_toc_closed', 'false');
			}
			syncUI();
		}

		if (btnSidebar) btnSidebar.onclick = toggleSidebar;
		if (btnToc) btnToc.onclick = toggleToc;
		if (btnFocus) btnFocus.onclick = toggleFocus;

		// Keyboard Shortcuts:
		// Ctrl+B / Cmd+B -> Toggle left sidebar
		// Alt+Z -> Toggle focus mode
		// Escape -> Exit focus mode
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && isFocusActive()) {
				e.preventDefault();
				toggleFocus();
				return;
			}
			if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b' && !e.shiftKey) {
				e.preventDefault();
				toggleSidebar();
				return;
			}
			if (e.altKey && e.key.toLowerCase() === 'z') {
				e.preventDefault();
				toggleFocus();
				return;
			}
		});

		syncUI();
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupPanelControls);
	} else {
		setupPanelControls();
	}
</script>
