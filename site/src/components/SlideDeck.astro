---
import { parseMarkdownWithHighlight } from '../utils/highlighter';

interface Props {
	title: string;
	markdown: string;
	backUrl: string;
}

const { title, markdown, backUrl } = Astro.props;

// Strip initial frontmatter if present
let content = markdown;
if (content.startsWith('---')) {
	const secondDelimiterIndex = content.indexOf('---', 3);
	if (secondDelimiterIndex !== -1) {
		content = content.slice(secondDelimiterIndex + 3).trim();
	}
}

// Split on slide separator ---
const rawSlides = content
	.split(/\n---\s*\n/)
	.map((s) => s.trim())
	.filter((s) => s.length > 0);

// Helper to transform Bad vs Clean code blocks into side-by-side comparison grids
function transformSlideHtml(html: string): string {
	const badCleanRegex =
		/<(?:p|h[2-6])>(?:\s*<strong>)?\s*(?:Bad|Before|Anti-Pattern|Smell)[^<]*(?:<\/strong>)?<\/(?:p|h[2-6])>\s*(<pre[\s\S]*?<\/pre>)\s*<(?:p|h[2-6])>(?:\s*<strong>)?\s*(?:Clean|After|Solution|Refactored)[^<]*(?:<\/strong>)?<\/(?:p|h[2-6])>\s*(<pre[\s\S]*?<\/pre>)/gi;

	return html.replace(badCleanRegex, (_match, badCode, cleanCode) => {
		return `
			<div class="compare-container">
				<div class="compare-pane compare-bad">
					<div class="compare-header">
						<span class="compare-dot bad-dot"></span>
						<span class="compare-title">Smell / Bad</span>
					</div>
					${badCode}
				</div>
				<div class="compare-pane compare-clean">
					<div class="compare-header">
						<span class="compare-dot clean-dot"></span>
						<span class="compare-title">Clean / Refactored</span>
					</div>
					${cleanCode}
				</div>
			</div>
		`;
	});
}

// Parse markdown for each slide with Shiki syntax highlighting
const slidesHtml = rawSlides.map((slideMarkdown) => {
	const rawParsed = parseMarkdownWithHighlight(slideMarkdown);
	return transformSlideHtml(rawParsed);
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title} — Presentation Deck</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<style is:global>
			:root {
				--bg-canvas: #070a12;
				--bg-panel: #0d1322;
				--bg-code: #040711;
				--border-subtle: #1a2336;
				--border-active: #38bdf8;
				--text-title: #f8fafc;
				--text-body: #cbd5e1;
				--text-meta: #64748b;
				--accent-cyan: #38bdf8;
				--accent-amber: #f59e0b;
				--accent-emerald: #10b981;
				--accent-rose: #f43f5e;
			}

			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}

			body {
				font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
				background-color: var(--bg-canvas);
				color: var(--text-body);
				height: 100vh;
				width: 100vw;
				overflow: hidden;
				display: flex;
				flex-direction: column;
				user-select: none;
			}

			/* Progress Indicator */
			#progress-line {
				height: 3px;
				background: var(--accent-cyan);
				width: 0%;
				transition: width 0.2s cubic-bezier(0.4, 0, 0.2, 1);
				z-index: 100;
			}

			/* Header Navigation Bar */
			header {
				height: 48px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 1.5rem;
				border-bottom: 1px solid var(--border-subtle);
				background: var(--bg-canvas);
				z-index: 40;
			}

			.header-left {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.return-btn {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.75rem;
				color: var(--text-meta);
				text-decoration: none;
				padding: 0.3rem 0.6rem;
				border: 1px solid var(--border-subtle);
				border-radius: 4px;
				background: var(--bg-panel);
				transition: all 0.15s ease;
			}

			.return-btn:hover {
				color: var(--text-title);
				border-color: var(--accent-cyan);
			}

			.deck-meta-title {
				font-size: 0.85rem;
				font-weight: 600;
				color: var(--text-title);
			}

			.header-right {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.tool-btn {
				background: var(--bg-panel);
				color: var(--text-meta);
				border: 1px solid var(--border-subtle);
				border-radius: 4px;
				padding: 0.3rem 0.6rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				transition: all 0.15s ease;
			}

			.tool-btn:hover {
				color: var(--text-title);
				border-color: var(--accent-cyan);
			}

			/* Main Stage Canvas */
			main {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 1.25rem 2rem;
				position: relative;
				overflow: hidden;
			}

			.slide-board {
				width: 100%;
				max-width: 1300px;
				height: 100%;
				max-height: 84vh;
				background: var(--bg-panel);
				border: 1px solid var(--border-subtle);
				border-radius: 8px;
				display: flex;
				flex-direction: column;
				justify-content: center;
				padding: 2.25rem 3.5rem 3rem 3.5rem;
				overflow: hidden;
				user-select: text;
				position: relative;
				box-shadow: 0 16px 36px rgba(0, 0, 0, 0.4);
			}

			/* Auto-fitting slide wrapper */
			#slide-content {
				width: 100%;
				transition: transform 0.12s ease-out;
			}

			/* Drawing Sheet Title Block */
			.sheet-titleblock {
				position: absolute;
				bottom: 0.85rem;
				right: 1.5rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.7rem;
				color: var(--text-meta);
				display: flex;
				gap: 1rem;
				border-top: 1px solid var(--border-subtle);
				padding-top: 0.4rem;
				z-index: 10;
			}

			.sheet-titleblock span strong {
				color: var(--accent-cyan);
				font-weight: 600;
			}

			/* Typography Scale (Disciplined & Compact for Slides) */
			.slide-board h1 {
				font-size: 2rem;
				font-weight: 800;
				letter-spacing: -0.03em;
				color: var(--text-title);
				margin-bottom: 1.2rem;
				line-height: 1.25;
			}

			.slide-board h2 {
				font-size: 1.45rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				color: var(--text-title);
				margin-bottom: 1rem;
				line-height: 1.3;
			}

			.slide-board h3 {
				font-size: 1.15rem;
				font-weight: 600;
				color: var(--accent-cyan);
				margin-bottom: 0.75rem;
			}

			.slide-board p,
			.slide-board li {
				font-size: 1.02rem;
				line-height: 1.6;
				color: var(--text-body);
				margin-bottom: 0.5rem;
			}

			.slide-board ul,
			.slide-board ol {
				margin-left: 1.75rem;
				margin-bottom: 0.85rem;
			}

			.slide-board li {
				margin-bottom: 0.45rem;
			}

			.slide-board blockquote {
				border-left: 3px solid var(--accent-cyan);
				background: rgba(56, 189, 248, 0.05);
				padding: 0.85rem 1.25rem;
				border-radius: 0 4px 4px 0;
				font-size: 1.05rem;
				color: var(--text-title);
				margin: 1rem 0;
				font-style: normal;
			}

			.slide-board :not(pre) > code {
				font-family: 'JetBrains Mono', monospace;
				background: var(--bg-code);
				border: 1px solid var(--border-subtle);
				padding: 0.12rem 0.35rem;
				border-radius: 4px;
				color: #f472b6;
				font-size: 0.88em;
			}

			.slide-board pre.shiki,
			.slide-board pre {
				background-color: var(--bg-code) !important;
				border: 1px solid var(--border-subtle);
				border-radius: 6px;
				padding: 0.85rem 1.1rem;
				overflow-x: auto;
				margin: 0.75rem 0;
				font-family: 'JetBrains Mono', monospace;
			}

			.slide-board pre code {
				background: none !important;
				border: none !important;
				padding: 0 !important;
				font-size: 0.88rem;
				line-height: 1.48;
				font-family: 'JetBrains Mono', monospace;
			}

			.slide-board table {
				width: 100%;
				border-collapse: collapse;
				margin: 1rem 0;
				font-size: 0.95rem;
			}

			.slide-board th,
			.slide-board td {
				border: 1px solid var(--border-subtle);
				padding: 0.6rem 0.85rem;
				text-align: left;
			}

			.slide-board th {
				background: #111827;
				color: var(--accent-cyan);
				font-weight: 600;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.82rem;
			}

			/* Side-by-Side Comparison Container (Smell vs Clean) */
			.compare-container {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25rem;
				margin: 0.75rem 0;
				align-items: stretch;
			}

			.compare-pane {
				background: var(--bg-code);
				border: 1px solid var(--border-subtle);
				border-radius: 6px;
				display: flex;
				flex-direction: column;
				overflow: hidden;
			}

			.compare-pane pre,
			.compare-pane pre.shiki {
				margin: 0 !important;
				border: none !important;
				border-radius: 0 !important;
				flex: 1;
				padding: 0.85rem 1rem !important;
			}

			.compare-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.4rem 0.85rem;
				border-bottom: 1px solid var(--border-subtle);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.04em;
			}

			.compare-bad {
				border-top: 3px solid var(--accent-rose);
			}

			.compare-bad .compare-header {
				background: rgba(244, 63, 94, 0.08);
				color: #fda4af;
			}

			.compare-clean {
				border-top: 3px solid var(--accent-emerald);
			}

			.compare-clean .compare-header {
				background: rgba(16, 185, 129, 0.08);
				color: #86efac;
			}

			.compare-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
			}

			.bad-dot {
				background: var(--accent-rose);
			}

			.clean-dot {
				background: var(--accent-emerald);
			}

			/* Footer Controls Bar */
			footer {
				height: 48px;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0 2rem;
				background: var(--bg-canvas);
				border-top: 1px solid var(--border-subtle);
				z-index: 40;
			}

			.key-reference {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				color: var(--text-meta);
			}

			.key-reference kbd {
				background: var(--bg-panel);
				border: 1px solid var(--border-subtle);
				border-radius: 3px;
				padding: 0.12rem 0.3rem;
				color: var(--text-body);
			}

			.nav-dock {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.step-btn {
				background: var(--bg-panel);
				color: var(--text-title);
				border: 1px solid var(--border-subtle);
				border-radius: 4px;
				width: 32px;
				height: 32px;
				display: flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: all 0.15s ease;
			}

			.step-btn:hover:not(:disabled) {
				border-color: var(--accent-cyan);
				background: #141d30;
			}

			.step-btn:disabled {
				opacity: 0.25;
				cursor: not-allowed;
			}

			.sheet-counter {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.82rem;
				color: var(--text-title);
				min-width: 80px;
				text-align: center;
			}

			/* Slide Index Overview Modal */
			#index-modal {
				display: none;
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				background: rgba(7, 10, 18, 0.96);
				backdrop-filter: blur(8px);
				z-index: 200;
				padding: 2.5rem;
				overflow-y: auto;
			}

			#index-modal.active {
				display: block;
			}

			.modal-bar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 2rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--border-subtle);
			}

			.modal-bar h2 {
				font-size: 1.25rem;
				font-weight: 700;
				color: var(--text-title);
			}

			.thumbnail-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1rem;
			}

			.thumbnail-card {
				background: var(--bg-panel);
				border: 1px solid var(--border-subtle);
				border-radius: 6px;
				padding: 1.1rem;
				height: 170px;
				overflow: hidden;
				cursor: pointer;
				position: relative;
				transition: border-color 0.15s ease;
				font-size: 0.78rem;
				line-height: 1.45;
				color: var(--text-body);
			}

			.thumbnail-card:hover {
				border-color: var(--accent-cyan);
			}

			.thumbnail-card.active {
				border-color: var(--accent-cyan);
				outline: 1px solid var(--accent-cyan);
			}

			.card-sheet-tag {
				position: absolute;
				bottom: 0.6rem;
				right: 0.6rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.68rem;
				color: var(--text-meta);
				background: var(--bg-canvas);
				border: 1px solid var(--border-subtle);
				padding: 0.1rem 0.35rem;
				border-radius: 3px;
			}

			/* Diagram presentation styling inside slides */
			.slide-board .interactive-diagram-container {
				margin: 0.5rem 0 1rem 0;
				background: rgba(13, 19, 34, 0.6);
				border: 1px solid var(--border-subtle);
				border-radius: 8px;
				overflow: hidden;
				position: relative;
			}

			/* Completely hide the diagram controller / header in presentation mode */
			.slide-board .diag-header {
				display: none !important;
			}

			.slide-board .diag-stage {
				position: relative;
				width: 100%;
				height: 56vh;
				min-height: 380px;
				background: var(--bg-canvas);
				background-image: radial-gradient(var(--border-subtle) 1px, transparent 1px);
				background-size: 20px 20px;
				overflow: hidden;
				cursor: grab;
				outline: none;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.slide-board .diag-stage.is-panning {
				cursor: grabbing;
			}

			.slide-board .diag-viewport {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				pointer-events: none;
			}

			.slide-board .diag-panzoom-target {
				transform-origin: center center;
				display: flex;
				align-items: center;
				justify-content: center;
				will-change: transform;
			}

			.slide-board .diag-panzoom-target svg {
				max-width: 95% !important;
				max-height: 95% !important;
				height: auto;
				pointer-events: auto;
				filter: drop-shadow(0 4px 16px rgba(0, 0, 0, 0.4));
			}

			.slide-board .diag-stage-hint {
				position: absolute;
				bottom: 0.4rem;
				right: 0.6rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.65rem;
				color: var(--text-meta);
				background: rgba(7, 10, 18, 0.75);
				padding: 0.15rem 0.45rem;
				border-radius: 3px;
				pointer-events: none;
				user-select: none;
				border: 1px solid var(--border-subtle);
			}

			.slide-board .diag-stage-hint kbd {
				background: var(--bg-panel);
				border: 1px solid var(--border-subtle);
				border-radius: 2px;
				padding: 0.05rem 0.25rem;
				color: var(--accent-cyan);
				font-family: inherit;
				font-size: 0.62rem;
			}

			/* Mini preview tag for thumbnail cards */
			.thumbnail-card .slide-mermaid-raw {
				display: flex;
				align-items: center;
				justify-content: center;
				padding: 0.5rem;
				background: var(--bg-canvas);
				border: 1px dashed var(--border-subtle);
				border-radius: 4px;
				margin: 0.4rem 0;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.68rem;
				color: var(--accent-cyan);
			}

			.thumbnail-card .slide-mermaid-raw pre {
				display: none;
			}

			.thumbnail-card .slide-mermaid-raw::before {
				content: "📐 UML Architectural Diagram";
			}
		</style>
	</head>
	<body>
		<div id="progress-line"></div>

		<header>
			<div class="header-left">
				<a href={backUrl} class="return-btn">
					<span>← Handbook</span>
				</a>
				<div class="deck-meta-title">{title}</div>
			</div>
			<div class="header-right">
				<button id="toggle-index-btn" class="tool-btn" title="Slide Index (G)">
					<span>Sheet Index [G]</span>
				</button>
				<button id="toggle-screen-btn" class="tool-btn" title="Fullscreen (F)">
					<span>Fullscreen [F]</span>
				</button>
			</div>
		</header>

		<main>
			<div id="slide-board" class="slide-board">
				<div id="slide-content"></div>
				<div class="sheet-titleblock">
					<span>COURSE <strong>DESIGN PATTERNS</strong></span>
					<span>INSTRUCTOR <strong>MOHAMED HELMY</strong></span>
					<span>SHEET <strong id="titleblock-num">01 / {slidesHtml.length}</strong></span>
				</div>
			</div>
		</main>

		<footer>
			<div class="key-reference">
				<kbd>Space</kbd> / <kbd>→</kbd> Next · <kbd>←</kbd> Prev · <kbd>G</kbd> Index · <kbd>F</kbd> Fullscreen
			</div>
			<div class="nav-dock">
				<button id="btn-prev" class="step-btn" title="Previous">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="15 18 9 12 15 6"></polyline>
					</svg>
				</button>
				<div id="counter-dock" class="sheet-counter">1 / {slidesHtml.length}</div>
				<button id="btn-next" class="step-btn" title="Next">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<polyline points="9 18 15 12 9 6"></polyline>
					</svg>
				</button>
			</div>
			<div></div>
		</footer>

		<!-- Slide Overview Grid Overlay -->
		<div id="index-modal">
			<div class="modal-bar">
				<h2>Slide Index ({slidesHtml.length} Sheets)</h2>
				<button id="close-modal-btn" class="tool-btn">Close [Esc]</button>
			</div>
			<div class="thumbnail-grid">
				{slidesHtml.map((html, idx) => (
					<div class="thumbnail-card" data-index={idx}>
						<div set:html={html} />
						<div class="card-sheet-tag">#{idx + 1}</div>
					</div>
				))}
			</div>
		</div>

		<!-- Slide Deck Data Payload -->
		<script id="slide-data" type="application/json" set:html={JSON.stringify(slidesHtml)} />

		<!-- Slide Presenter Script with Auto-Fit & Interactive Diagram Engine -->
		<script>
			import { enhanceMermaidInContainer } from '../utils/diagram-engine';

			const dataEl = document.getElementById('slide-data');
			const slidesHtml: string[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
			const total = slidesHtml.length;
			let current = 0;

			const hash = window.location.hash.replace('#', '');
			if (hash && !isNaN(parseInt(hash, 10))) {
				const req = parseInt(hash, 10) - 1;
				if (req >= 0 && req < total) current = req;
			}

			const board = document.getElementById('slide-board') as HTMLElement;
			const contentEl = document.getElementById('slide-content') as HTMLElement;
			const counterDock = document.getElementById('counter-dock') as HTMLElement;
			const titleblockNum = document.getElementById('titleblock-num') as HTMLElement;
			const progressLine = document.getElementById('progress-line') as HTMLElement;
			const btnPrev = document.getElementById('btn-prev') as HTMLButtonElement;
			const btnNext = document.getElementById('btn-next') as HTMLButtonElement;
			const modal = document.getElementById('index-modal') as HTMLElement;
			const btnToggleIndex = document.getElementById('toggle-index-btn') as HTMLElement;
			const btnCloseModal = document.getElementById('close-modal-btn') as HTMLElement;
			const btnToggleScreen = document.getElementById('toggle-screen-btn') as HTMLElement;

			// Dynamic Auto-fit engine: scales slide content so it never overflows
			function autoFit() {
				if (!contentEl || !board) return;
				contentEl.style.transform = 'none';
				contentEl.style.width = '100%';

				// If there's an active interactive diagram, don't over-scale
				if (contentEl.querySelector('.interactive-diagram-container')) {
					return;
				}

				const availableHeight = board.clientHeight - 70;
				const naturalHeight = contentEl.scrollHeight;

				if (naturalHeight > availableHeight && naturalHeight > 0) {
					const scale = Math.max(0.68, availableHeight / naturalHeight);
					contentEl.style.transform = `scale(${scale})`;
					contentEl.style.transformOrigin = 'center center';
					contentEl.style.width = `${100 / scale}%`;
				}
			}

			async function showSlide(idx: number) {
				if (idx < 0 || idx >= total) return;
				current = idx;

				contentEl.innerHTML = slidesHtml[current];
				board.scrollTop = 0;

				// Enhance any Mermaid diagrams in the active slide
				await enhanceMermaidInContainer(contentEl);

				requestAnimationFrame(() => {
					autoFit();
				});

				if (counterDock) counterDock.textContent = `${current + 1} / ${total}`;
				if (titleblockNum) titleblockNum.textContent = `${String(current + 1).padStart(2, '0')} / ${total}`;
				if (progressLine) progressLine.style.width = `${((current + 1) / total) * 100}%`;

				if (btnPrev) btnPrev.disabled = current === 0;
				if (btnNext) btnNext.disabled = current === total - 1;

				window.location.hash = `${current + 1}`;

				document.querySelectorAll('.thumbnail-card').forEach((card, i) => {
					if (i === current) card.classList.add('active');
					else card.classList.remove('active');
				});
			}

			function next() {
				if (current < total - 1) showSlide(current + 1);
			}

			function prev() {
				if (current > 0) showSlide(current - 1);
			}

			btnPrev?.addEventListener('click', prev);
			btnNext?.addEventListener('click', next);
			btnToggleIndex?.addEventListener('click', () => modal?.classList.toggle('active'));
			btnCloseModal?.addEventListener('click', () => modal?.classList.remove('active'));
			btnToggleScreen?.addEventListener('click', () => {
				if (!document.fullscreenElement) {
					document.documentElement.requestFullscreen().catch(() => {});
				} else {
					document.exitFullscreen().catch(() => {});
				}
			});

			document.querySelectorAll('.thumbnail-card').forEach((card) => {
				card.addEventListener('click', () => {
					const idx = parseInt(card.getAttribute('data-index') || '0', 10);
					modal?.classList.remove('active');
					showSlide(idx);
				});
			});

			window.addEventListener('resize', autoFit);

			window.addEventListener('keydown', (e) => {
				if (modal?.classList.contains('active')) {
					if (e.key === 'Escape' || e.key === 'g' || e.key === 'G') {
						modal.classList.remove('active');
					}
					return;
				}

				// If an interactive diagram is fullscreen or focused, let the diagram handle events
				if (document.querySelector('.interactive-diagram-container.is-fullscreen')) {
					return;
				}

				const activeEl = document.activeElement;
				if (activeEl?.closest('.diag-stage') || activeEl?.closest('.interactive-diagram-container')) {
					return;
				}

				if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ' || e.key === 'PageDown') {
					e.preventDefault();
					next();
				} else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp' || e.key === 'PageUp') {
					e.preventDefault();
					prev();
				} else if (e.key === 'g' || e.key === 'G') {
					modal?.classList.toggle('active');
				} else if (e.key === 'f' || e.key === 'F') {
					if (!document.fullscreenElement) {
						document.documentElement.requestFullscreen().catch(() => {});
					} else {
						document.exitFullscreen().catch(() => {});
					}
				} else if (e.key === 'Home') {
					showSlide(0);
				} else if (e.key === 'End') {
					showSlide(total - 1);
				}
			});

			showSlide(current);
		</script>
	</body>
</html>
